&CONTROL
  calculation='vc-relax',
  outdir='.',
  prefix='H',
  pseudo_dir = '../../pseudos',
  verbosity='low',
  tprnfor=.true.,
  tstress=.true.,
  wfcdir='/tmp',
  disk_io='minimal',
/

&SYSTEM
  ibrav = 0
  A =    5.21000
  nat = 1
  ntyp = 1
  ecutwfc=46,
  ecutrho=221,
  input_dft='pbe',
  occupations='smearing',
  smearing='mv',
  degauss=0.005d0,
/

&ELECTRONS
  conv_thr=1d-08,
  mixing_beta=0.2d0,
  mixing_mode = 'local-TF',
  electron_maxstep = 300,
  diagonalization = 'cg',
/

&IONS
  ion_dynamics='bfgs',
/

&CELL
  cell_dynamics='bfgs',
  press=0.d0,
  press_conv_thr=0.1d0,
/

CELL_PARAMETERS {alat}
 -0.500000000000000   0.500000000000000   0.500000000000000 
  0.500000000000000  -0.500000000000000   0.500000000000000 
  0.500000000000000   0.500000000000000  -0.500000000000000 
ATOMIC_SPECIES
   H    1.00750   H.pbe-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS {crystal}
H   0.000000000000000   0.000000000000000   0.000000000000000 

K_POINTS {automatic}
